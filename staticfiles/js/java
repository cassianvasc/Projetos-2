// Estado da aplicação
let currentCategory = ‘todas’;
let displayedNews = 6;
let favorites = JSON.parse(localStorage.getItem(‘favorites’)) || [];
let isDarkMode = localStorage.getItem(‘darkMode’) === ‘true’;

// Inicialização
document.addEventListener(‘DOMContentLoaded’, () => {
initializeTheme();
renderNews();
renderFavorites();
setupEventListeners();
});

// Configurar tema
function initializeTheme() {
if (isDarkMode) {
document.body.classList.add(‘dark-mode’);
updateThemeIcon();
}
}

function updateThemeIcon() {
const themeToggle = document.getElementById(‘themeToggle’);
if (isDarkMode) {
themeToggle.innerHTML = ‘<i class="fas fa-sun"></i>’;
} else {
themeToggle.innerHTML = ‘<i class="fas fa-moon"></i>’;
}
}

// Event Listeners
function setupEventListeners() {
// Alternar tema
document.getElementById(‘themeToggle’).addEventListener(‘click’, toggleTheme);


// Busca
document.getElementById('searchBtn').addEventListener('click', handleSearch);
document.getElementById('searchInput').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') handleSearch();
});

// Categorias
document.querySelectorAll('.category-btn').forEach(btn => {
    btn.addEventListener('click', () => handleCategoryChange(btn));
});

// Carregar mais
document.getElementById('loadMoreBtn').addEventListener('click', loadMoreNews);

// Favorito da notícia em destaque
const featuredFavBtn = document.querySelector('.featured-content .favorite-btn');
if (featuredFavBtn) {
    featuredFavBtn.addEventListener('click', () => toggleFavorite('featured'));
    updateFavoriteButton(featuredFavBtn, 'featured');
}


}

// Alternar tema claro/escuro
function toggleTheme() {
isDarkMode = !isDarkMode;
document.body.classList.toggle('dark-mode');
localStorage.setItem('darkMode', isDarkMode);
updateThemeIcon();
}

// Renderizar notícias
function renderNews() {
const newsGrid = document.getElementById(‘newsGrid’);
const filteredNews = currentCategory === ‘todas’
? newsData
: newsData.filter(news => news.category === currentCategory);


const newsToDisplay = filteredNews.slice(0, displayedNews);

newsGrid.innerHTML = newsToDisplay.map(news => `
    <div class="news-card" data-id="${news.id}">
        <div class="news-card-image">
            <img src="${news.image}" alt="${news.title}">
            <span class="news-card-category">${getCategoryName(news.category)}</span>
        </div>
        <div class="news-card-content">
            <h3 class="news-card-title">${news.title}</h3>
            <p class="news-card-excerpt">${news.excerpt}</p>
            <div class="news-card-footer">
                <span class="news-card-date">
                    <i class="far fa-calendar"></i> ${formatDate(news.date)}
                </span>
                <button class="news-card-favorite ${isFavorite(news.id) ? 'active' : ''}" data-id="${news.id}">
                    <i class="${isFavorite(news.id) ? 'fas' : 'far'} fa-heart"></i>
                </button>
            </div>
        </div>
    </div>
`).join('');

// Adicionar event listeners aos botões de favorito
document.querySelectorAll('.news-card-favorite').forEach(btn => {
    btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFavorite(parseInt(btn.dataset.id));
    });
});

// Controlar botão "Carregar mais"
const loadMoreBtn = document.getElementById('loadMoreBtn');
if (displayedNews >= filteredNews.length) {
    loadMoreBtn.style.display = 'none';
} else {
    loadMoreBtn.style.display = 'inline-flex';
}


}

// Renderizar favoritos
function renderFavorites() {
const favoritesGrid = document.getElementById(‘favoritesGrid’);
const favoriteNews = newsData.filter(news => favorites.includes(news.id));


if (favoriteNews.length === 0) {
    favoritesGrid.innerHTML = '<p class="no-favorites">Você ainda não possui notícias favoritas. Clique no ❤ para adicionar!</p>';
    return;
}

favoritesGrid.innerHTML = favoriteNews.map(news => `
    <div class="news-card" data-id="${news.id}">
        <div class="news-card-image">
            <img src="${news.image}" alt="${news.title}">
            <span class="news-card-category">${getCategoryName(news.category)}</span>
        </div>
        <div class="news-card-content">
            <h3 class="news-card-title">${news.title}</h3>
            <p class="news-card-excerpt">${news.excerpt}</p>
            <div class="news-card-footer">
                <span class="news-card-date">
                    <i class="far fa-calendar"></i> ${formatDate(news.date)}
                </span>
                <button class="news-card-favorite active" data-id="${news.id}">
                    <i class="fas fa-heart"></i>
                </button>
            </div>
        </div>
    </div>
`).join('');

// Adicionar event listeners
document.querySelectorAll('#favoritesGrid .news-card-favorite').forEach(btn => {
    btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFavorite(parseInt(btn.dataset.id));
    });
});


}

// Alternar favorito
function toggleFavorite(newsId) {
const index = favorites.indexOf(newsId);


if (index > -1) {
    favorites.splice(index, 1);
} else {
    favorites.push(newsId);
}

localStorage.setItem('favorites', JSON.stringify(favorites));
renderNews();
renderFavorites();

// Atualizar botão da notícia em destaque se necessário
if (newsId === 'featured') {
    const featuredBtn = document.querySelector('.featured-content .favorite-btn');
    updateFavoriteButton(featuredBtn, 'featured');
}


}

// Verificar se é favorito
function isFavorite(newsId) {
return favorites.includes(newsId);
}

// Atualizar botão de favorito
function updateFavoriteButton(button, newsId) {
if (isFavorite(newsId)) {
button.classList.add(‘active’);
button.querySelector(‘i’).classList.remove(‘far’);
button.querySelector(‘i’).classList.add(‘fas’);
} else {
button.classList.remove(‘active’);
button.querySelector(‘i’).classList.remove(‘fas’);
button.querySelector(‘i’).classList.add(‘far’);
}
}

// Mudar categoria
function handleCategoryChange(button) {
document.querySelectorAll(’.category-btn’).forEach(btn => {
btn.classList.remove(‘active’);
});
button.classList.add(‘active’);


currentCategory = button.dataset.category;
displayedNews = 6;
renderNews();


}

// Buscar notícias
function handleSearch() {
const searchTerm = document.getElementById(‘searchInput’).value.toLowerCase();


if (!searchTerm) {
    alert('Digite algo para buscar!');
    return;
}

const results = newsData.filter(news => 
    news.title.toLowerCase().includes(searchTerm) ||
    news.excerpt.toLowerCase().includes(searchTerm)
);

const newsGrid = document.getElementById('newsGrid');

if (results.length === 0) {
    newsGrid.innerHTML = '<p class="no-favorites">Nenhuma notícia encontrada para sua busca.</p>';
    return;
}

newsGrid.innerHTML = results.map(news => `
    <div class="news-card" data-id="${news.id}">
        <div class="news-card-image">
            <img src="${news.image}" alt="${news.title}">
            <span class="news-card-category">${getCategoryName(news.category)}</span>
        </div>
        <div class="news-card-content">
            <h3 class="news-card-title">${news.title}</h3>
            <p class="news-card-excerpt">${news.excerpt}</p>
            <div class="news-card-footer">
                <span class="news-card-date">
                    <i class="far fa-calendar"></i> ${formatDate(news.date)}
                </span>
                <button class="news-card-favorite ${isFavorite(news.id) ? 'active' : ''}" data-id="${news.id}">
                    <i class="${isFavorite(news.id) ? 'fas' : 'far'} fa-heart"></i>
                </button>
            </div>
        </div>
    </div>
`).join('');

// Adicionar event listeners
document.querySelectorAll('.news-card-favorite').forEach(btn => {
    btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleFavorite(parseInt(btn.dataset.id));
    });
});

document.getElementById('loadMoreBtn').style.display = 'none';


}

// Carregar mais notícias
function loadMoreNews() {
displayedNews += 3;
renderNews();
}

// Formatar data
function formatDate(dateString) {
const date = new Date(dateString);
const options = { day: 'numeric', month: 'long', year: 'numeric' };
return date.toLocaleDateString('pt-BR', options);
}

// Obter nome da categoria
function getCategoryName(category) {
const categories = {
'politica': 'Política',
'economia': 'Economia',
'esportes': 'Esportes',
'tecnologia': 'Tecnologia',
'cultura': 'Cultura',
'mundo': 'Mundo'
};
return categories[category] || category;
}

// Animação suave ao rolar
document.querySelectorAll('a[href^=”#”]').forEach(anchor => {
anchor.addEventListener('click', function (e) {
e.preventDefault();
const target = document.querySelector(this.getAttribute('href'));
if (target) {
target.scrollIntoView({
behavior: 'smooth',
block: 'start'
});
}
});
});

// Detectar scroll e adicionar sombra ao header
window.addEventListener('scroll', () => {
const header = document.querySelector('.header');
if (window.scrollY > 50) {
header.style.boxShadow = '0 5px 20px rgba(0, 0, 0, 0.1)';
} else {
header.style.boxShadow = 'var(–shadow)';
}
});

